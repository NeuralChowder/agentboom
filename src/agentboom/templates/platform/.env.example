# ── {{AGENT_NAME}} environment ─────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ────────────────────────────────────────────────────────────
# Bearer token for the platform <-> agent HTTP API.
# Generate one with:  openssl rand -hex 32
QWEN_SERVER_TOKEN=

# Admin password for gateway /admin/* endpoints (HTTP Basic, user "admin").
PLATFORM_ADMIN_PASSWORD=

# Bearer token for the platform gateway API. Every non-public route
# requires it; the /public/* surface is the only exception, and that
# boundary is enforced in code — there is no way to weaken it. The
# agent, the dashboard and any external client use it.
# Generate one with:  openssl rand -hex 32
PLATFORM_TOKEN=

# ── LLM gateway (one-shot completions via agentboom_sdk.llm) ───────────
# Used by mini-apps that reason (email triage, digests, finance classify,
# template drafting...). Any OpenAI-compatible endpoint works — your own
# local models with your own tags, or a hosted API. Leave blank if this
# agent should do no direct LLM calls: reasoning mini-apps degrade to
# deterministic/manual mode, everything else still works.
#
#   Local OpenAI-compatible server (llama.cpp / vLLM / Ollama / LiteLLM):
#     LLM_BASE_URL=http://host.docker.internal:8080/v1
#     LLM_API_KEY=not-needed
#     LLM_MODEL=<your model tag>
#   Hosted (OpenAI-shaped):
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_API_KEY=sk-...
#     LLM_MODEL=gpt-4o-mini
#
# (Agent turns via `qwen serve` are separate — their model config lives
# in .qwen-docker/settings.json.)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_TIMEOUT_SEC=60

# ── Optional ────────────────────────────────────────────────────────────
# QWEN_VERSION=latest            # @qwen-code/qwen-code version to install
# QWEN_REBUILD=0                 # bump to bust the Docker layer cache and reinstall qwen
# USER_ID=1000                   # uid of the in-container user (match the host user)
# USER_NAME=user
# EXTRA_APT_PACKAGES=            # extra apt packages for the agent container, space-separated
# Host ports — set at init, change here if you need to (recreate after editing).
PORT_AGENT={{PORT_AGENT}}
PORT_PLATFORM={{PORT_PLATFORM}}
PORT_DASHBOARD={{PORT_DASHBOARD}}
# SCHEDULER_TICK_SEC=10
# AGENT_MAX_CONCURRENT=1         # parallel LLM-bound tasks (1 = serialized; keeps the model gateway from bursting)
# QWEN_SERVE_ARGS=               # extra args for `qwen serve` (e.g. --channel all)
