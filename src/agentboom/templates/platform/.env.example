# ── {{AGENT_NAME}} environment ─────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ────────────────────────────────────────────────────────────
# Bearer token for the platform <-> agent HTTP API.
# Generate one with:  openssl rand -hex 32
QWEN_SERVER_TOKEN=

# Admin password for gateway /admin/* endpoints (HTTP Basic, user "admin").
PLATFORM_ADMIN_PASSWORD=

# ── LLM gateway (one-shot completions via sdk.llm) ─────────────────────
# Any OpenAI-compatible endpoint. Leave blank if this agent does no
# direct LLM calls (agent turns via `qwen serve` have their own config
# in .qwen-docker/settings.json).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Optional ────────────────────────────────────────────────────────────
# QWEN_VERSION=latest            # @qwen-code/qwen-code version to install
# QWEN_REBUILD=0                 # bump to bust the Docker layer cache and reinstall qwen
# USER_ID=1000                   # uid of the in-container user (match the host user)
# USER_NAME=user
# EXTRA_APT_PACKAGES=            # extra apt packages for the agent container, space-separated
# PORT_AGENT=4170                # host port publishing the agent HTTP API
# PORT_PLATFORM=8000             # host port publishing the platform gateway
# SCHEDULER_TICK_SEC=10
# AGENT_MAX_CONCURRENT=1         # parallel LLM-bound tasks (1 = serialized; keeps the model gateway from bursting)
# QWEN_SERVE_ARGS=               # extra args for `qwen serve` (e.g. --channel all)
