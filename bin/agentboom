#!/usr/bin/env python3
"""Zero-install entry point: run agentboom straight from a source checkout."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from agentboom.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
